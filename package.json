{
  "name": "@linzjs/stac",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:fmt && npm run lint:oxlint",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:fmt": "oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write .",
    "format": "oxfmt --write .",
    "version-schema": "find extensions -type f -print0 | xargs -0 sed -i \"s/_STAC_VERSION_/v$npm_package_version/\"",
    "test": "node --test 'extensions/*/tests/*.test.mjs' && ./validate.sh"
  },
  "devDependencies": {
    "@linzjs/style": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "stac-node-validator": "^2.0.0"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
