{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "84540598f16a77dc9a02f551b3a8b516f561f1bc",
  "include-component-in-tag": true,
  "pull-request-title-pattern": "release: ${version}",
  "group-pull-request-title-pattern": "release: ${version}",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false
    },
    "extensions/aerial-photo": {
      "component": "aerial-photo"
    },
    "extensions/camera": {
      "component": "camera"
    },
    "extensions/film": {
      "component": "film"
    },
    "extensions/historical-imagery": {
      "component": "historical-imagery"
    },
    "extensions/linz": {
      "component": "linz"
    },
    "extensions/quality": {
      "component": "quality"
    },
    "extensions/scanning": {
      "component": "scanning"
    }
  }
}
